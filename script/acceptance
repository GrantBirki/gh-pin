#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

echo -e "${BLUE}🧪 Running acceptance tests...${OFF}"

TEMP_DIR=$(mktemp -d)
echo -e "${BLUE}Using temporary directory: ${TEMP_DIR}${OFF}"

cleanup() {
    echo -e "${BLUE}Cleaning up temporary files...${OFF}"
    if [[ -n "${REGISTRY_PID:-}" ]] && kill -0 "${REGISTRY_PID}" 2>/dev/null; then
        kill "${REGISTRY_PID}"
        wait "${REGISTRY_PID}" 2>/dev/null || true
    fi
    rm -rf "${TEMP_DIR}"
}
trap cleanup EXIT

fail() {
    echo -e "${RED}❌ FAIL: $*${OFF}"
    exit 1
}

assert_file_contains() {
    local needle="$1"
    local path="$2"

    if ! grep -Fq "${needle}" "${path}"; then
        fail "Expected ${path} to contain: ${needle}"
    fi
}

assert_output_contains() {
    local needle="$1"
    local output="$2"

    if [[ "${output}" != *"${needle}"* ]]; then
        echo "Output:"
        echo "${output}"
        fail "Expected output to contain: ${needle}"
    fi
}

echo -e "${BLUE}Using go run to execute gh-pin directly...${OFF}"
echo -e "${BLUE}Starting local fake OCI registry...${OFF}"

REGISTRY_OUTPUT="${TEMP_DIR}/registry.out"
REGISTRY_LOG="${TEMP_DIR}/registry.log"
go run -mod=vendor ./test/fakes/registry >"${REGISTRY_OUTPUT}" 2>"${REGISTRY_LOG}" &
REGISTRY_PID=$!

REGISTRY_ADDR=""
for _ in {1..50}; do
    if ! kill -0 "${REGISTRY_PID}" 2>/dev/null; then
        echo "Registry stdout:"
        cat "${REGISTRY_OUTPUT}" || true
        echo "Registry stderr:"
        cat "${REGISTRY_LOG}" || true
        fail "local fake registry exited before becoming ready"
    fi

    if [[ -s "${REGISTRY_OUTPUT}" ]]; then
        REGISTRY_ADDR=$(sed -n 's/^REGISTRY_ADDR=//p' "${REGISTRY_OUTPUT}" | head -n 1)
        if [[ -n "${REGISTRY_ADDR}" ]]; then
            break
        fi
    fi

    sleep 0.1
done

if [[ -z "${REGISTRY_ADDR}" ]]; then
    echo "Registry stdout:"
    cat "${REGISTRY_OUTPUT}" || true
    echo "Registry stderr:"
    cat "${REGISTRY_LOG}" || true
    fail "local fake registry did not report an address"
fi

export GH_PIN_INSECURE_REGISTRIES="${REGISTRY_ADDR}"

INDEX_DIGEST="sha256:944ee135f516fd1bc20a4e840486e034f988f3e60ec03ba047a00da9c8881d1c"
AMD64_DIGEST="sha256:2222222222222222222222222222222222222222222222222222222222222222"
ARM64_DIGEST="sha256:3333333333333333333333333333333333333333333333333333333333333333"

CHECKOUT_SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
SETUP_GO_SHA="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
SETUP_NODE_SHA="cccccccccccccccccccccccccccccccccccccccc"
ACTION_MAP="${TEMP_DIR}/github-actions-map.json"
cat > "${ACTION_MAP}" <<EOF
{
  "actions/checkout@v4": "${CHECKOUT_SHA}",
  "actions/checkout@v3": "${CHECKOUT_SHA}",
  "actions/setup-go@v5": "${SETUP_GO_SHA}",
  "actions/setup-node@v4": "${SETUP_NODE_SHA}"
}
EOF
export GH_PIN_GITHUB_RESOLVER_MAP="${ACTION_MAP}"

LOCAL_UBUNTU="${REGISTRY_ADDR}/library/ubuntu:latest"
LOCAL_ALPINE="${REGISTRY_ADDR}/library/alpine:3.18"
LOCAL_NGINX="${REGISTRY_ADDR}/library/nginx:latest"
LOCAL_POSTGRES="${REGISTRY_ADDR}/library/postgres:15"

# Test 1: Dockerfile pinning
echo -e "${BLUE}Test 1: Dockerfile SHA pinning...${OFF}"

cat > "${TEMP_DIR}/Dockerfile" <<EOF
FROM ${LOCAL_UBUNTU}
FROM ${LOCAL_ALPINE}
EOF

assert_file_contains "FROM ${LOCAL_UBUNTU}" "${TEMP_DIR}/Dockerfile"
assert_file_contains "FROM ${LOCAL_ALPINE}" "${TEMP_DIR}/Dockerfile"

echo -e "${GREEN}✅ Test file contains unpinned images as expected${OFF}"

echo -e "${BLUE}Running gh-pin on test Dockerfile...${OFF}"
go run -mod=vendor ./cmd/gh-pin --no-color "${TEMP_DIR}/Dockerfile"

assert_file_contains "FROM ${LOCAL_UBUNTU}@${INDEX_DIGEST}" "${TEMP_DIR}/Dockerfile"
assert_file_contains "FROM ${LOCAL_ALPINE}@${INDEX_DIGEST}" "${TEMP_DIR}/Dockerfile"

echo -e "${GREEN}✅ PASS: Both images were successfully pinned to deterministic index digests${OFF}"

# Test 2: Dry-run mode
echo -e "${BLUE}Test 2: Dry-run mode...${OFF}"

mkdir -p "${TEMP_DIR}/dry-run-test"
cat > "${TEMP_DIR}/dry-run-test/Dockerfile" <<EOF
FROM ${LOCAL_UBUNTU}
EOF

before=$(<"${TEMP_DIR}/dry-run-test/Dockerfile")
go run -mod=vendor ./cmd/gh-pin --no-color --dry-run "${TEMP_DIR}/dry-run-test/Dockerfile"
after=$(<"${TEMP_DIR}/dry-run-test/Dockerfile")

if [[ "${before}" != "${after}" ]]; then
    fail "File was modified in dry-run mode"
fi

echo -e "${GREEN}✅ PASS: Dry-run mode did not modify the file${OFF}"

# Test 3: Version flag
echo -e "${BLUE}Test 3: Version flag...${OFF}"

version_output=$(go run -mod=vendor ./cmd/gh-pin --version)
if [[ ! "$version_output" =~ "built at" ]]; then
    echo "Got: $version_output"
    fail "Version output does not contain expected format"
fi

echo -e "${GREEN}✅ PASS: Version flag works correctly${OFF}"

# Test 4: Algorithm flag
echo -e "${BLUE}Test 4: Algorithm flag functionality...${OFF}"

mkdir -p "${TEMP_DIR}/algo-test"
echo "FROM ${LOCAL_UBUNTU}@sha256:7c06e91f61fa88c08cc74f7e1b7c69ae24910d745357e0dfe1d2c0322aaf20f9" > "${TEMP_DIR}/algo-test/Dockerfile"

output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run --quiet "${TEMP_DIR}/algo-test/Dockerfile" 2>&1 || true)
if [[ -n "$output" ]]; then
    echo "Got output: $output"
    fail "Default algo=sha256 should skip already pinned images"
fi

output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run --algo=sha512 "${TEMP_DIR}/algo-test/Dockerfile" 2>&1 || true)
assert_output_contains "DOCKERFILE" "${output}"
assert_output_contains "${LOCAL_UBUNTU}@sha256:7c06e91f61fa88c08cc74f7e1b7c69ae24910d745357e0dfe1d2c0322aaf20f9" "${output}"

echo -e "${GREEN}✅ PASS: Algorithm flag works correctly${OFF}"

# Test 5: GitHub Actions workflow processing
echo -e "${BLUE}Test 5: GitHub Actions workflow processing...${OFF}"

mkdir -p "${TEMP_DIR}/github-actions-test/.github/workflows"
cat > "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml" << 'EOF'
name: test
on: push
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
EOF

echo -e "${BLUE}Testing GitHub Actions dry-run with static resolver...${OFF}"
output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml" 2>&1 || true)
assert_output_contains "Processing GitHub Actions" "${output}"
assert_output_contains "actions/checkout@${CHECKOUT_SHA}" "${output}"
assert_output_contains "actions/setup-go@${SETUP_GO_SHA}" "${output}"

go run -mod=vendor ./cmd/gh-pin --no-color "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml"
assert_file_contains "uses: actions/checkout@${CHECKOUT_SHA} # pin@v4" "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml"
assert_file_contains "uses: actions/setup-go@${SETUP_GO_SHA} # pin@v5" "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml"

echo -e "${GREEN}✅ PASS: GitHub Actions workflow processing works offline${OFF}"

# Test force mode flags
echo -e "${BLUE}Test 6: Force mode flags...${OFF}"

output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run --mode=docker "${TEMP_DIR}/github-actions-test/.github/workflows/test.yml" 2>&1 || true)
if [[ "$output" =~ "Processing" ]]; then
    echo "Got output: $output"
    fail "Force docker mode should ignore GitHub Actions workflows"
fi

output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run --mode=actions "${TEMP_DIR}/Dockerfile" 2>&1 || true)
if [[ "$output" =~ "Processing" ]]; then
    echo "Got output: $output"
    fail "Force actions mode should ignore Dockerfiles"
fi

echo -e "${GREEN}✅ PASS: Force mode flags work correctly${OFF}"

# Test 7: Platform-specific pinning
echo -e "${BLUE}Test 7: Platform-specific pinning functionality...${OFF}"

mkdir -p "${TEMP_DIR}/platform-test"
cat > "${TEMP_DIR}/platform-test/Dockerfile" <<EOF
FROM ${LOCAL_NGINX}
FROM ${LOCAL_POSTGRES}
EOF

cat > "${TEMP_DIR}/platform-test/docker-compose.yml" <<EOF
version: '3.8'
services:
  web:
    image: ${LOCAL_NGINX}
    ports:
      - "80:80"
  db:
    image: ${LOCAL_POSTGRES}
    environment:
      POSTGRES_DB: mydb
EOF

echo -e "${BLUE}Testing platform-specific Dockerfile pinning (linux/amd64)...${OFF}"
dockerfile_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=linux/amd64 --dry-run "${TEMP_DIR}/platform-test/Dockerfile" 2>&1 || true)
assert_output_contains "${LOCAL_NGINX}@${AMD64_DIGEST}" "${dockerfile_output}"
assert_output_contains "${LOCAL_POSTGRES}@${AMD64_DIGEST}" "${dockerfile_output}"

if [[ "$dockerfile_output" =~ "# pin@" ]]; then
    echo "Got output: $dockerfile_output"
    fail "Platform-specific pinning should not show comments"
fi

echo -e "${GREEN}✅ PASS: Platform-specific Dockerfile pinning works correctly${OFF}"

echo -e "${BLUE}Testing platform-specific Docker Compose pinning (linux/arm64)...${OFF}"
compose_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=linux/arm64 --dry-run "${TEMP_DIR}/platform-test/docker-compose.yml" 2>&1 || true)
assert_output_contains "Processing Compose" "${compose_output}"
assert_output_contains "${LOCAL_NGINX}@${ARM64_DIGEST}" "${compose_output}"
assert_output_contains "${LOCAL_POSTGRES}@${ARM64_DIGEST}" "${compose_output}"

if [[ "$compose_output" =~ "# pin@" ]]; then
    echo "Got output: $compose_output"
    fail "Platform-specific Compose pinning should not show comments"
fi

echo -e "${GREEN}✅ PASS: Platform-specific Docker Compose pinning works correctly${OFF}"

echo -e "${BLUE}Testing platform specificity with different architectures...${OFF}"

amd64_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=linux/amd64 --dry-run "${TEMP_DIR}/platform-test/Dockerfile" 2>&1 || true)
arm64_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=linux/arm64 --dry-run "${TEMP_DIR}/platform-test/Dockerfile" 2>&1 || true)
assert_output_contains "${LOCAL_NGINX}@${AMD64_DIGEST}" "${amd64_output}"
assert_output_contains "${LOCAL_NGINX}@${ARM64_DIGEST}" "${arm64_output}"

echo -e "${GREEN}✅ PASS: Multiple platform architectures work correctly${OFF}"

echo -e "${BLUE}Testing invalid platform handling...${OFF}"
invalid_platform_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=invalid/platform --dry-run "${TEMP_DIR}/platform-test/Dockerfile" 2>&1 || true)
if [[ ! "$invalid_platform_output" =~ "Warning: Could not find manifest for platform" ]] || [[ ! "$invalid_platform_output" =~ "Falling back" ]]; then
    echo "Got output: $invalid_platform_output"
    fail "Invalid platform should produce warning and fallback message"
fi
assert_output_contains "${LOCAL_NGINX}@${INDEX_DIGEST}" "${invalid_platform_output}"

echo -e "${GREEN}✅ PASS: Invalid platform handling works correctly (graceful fallback)${OFF}"

echo -e "${BLUE}Testing index digest vs platform-specific digest behavior...${OFF}"

default_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --dry-run "${TEMP_DIR}/platform-test/docker-compose.yml" 2>&1 || true)
assert_output_contains "${LOCAL_NGINX}@${INDEX_DIGEST}" "${default_output}"

platform_output=$(go run -mod=vendor ./cmd/gh-pin --no-color --platform=linux/amd64 --dry-run "${TEMP_DIR}/platform-test/docker-compose.yml" 2>&1 || true)
assert_output_contains "${LOCAL_NGINX}@${AMD64_DIGEST}" "${platform_output}"

echo -e "${GREEN}✅ PASS: Index vs platform-specific behavior works correctly${OFF}"

echo -e "${GREEN}🎉 All acceptance tests passed!${OFF}"
